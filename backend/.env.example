# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:password@localhost:5432/qr_dining?schema=public"

# Server
PORT=5000

# IMPORTANT (production QR fix):
# CLIENT_URL must be the PUBLIC domain where the frontend is actually hosted
# (e.g. "https://menu.yourrestaurant.com"). Every table's QR code is generated
# by appending /menu/<qrToken> to this value. If this is left as localhost
# (or an internal IP) after you deploy, every printed QR code will point to
# a URL only reachable from your own laptop — that's the #1 reason a QR scan
# "doesn't open properly" for customers.
# If you ever change domains, you don't need to recreate tables — just update
# this value and use the "Regenerate QR" button in Tables & QR management.
CLIENT_URL="http://localhost:5173"

# Auth
JWT_SECRET="replace-this-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# Payment Gateway (optional - for online payments)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Firebase Cloud Messaging (optional - for push notifications)
FCM_SERVER_KEY=""
